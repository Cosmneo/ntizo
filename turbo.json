{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false,
      // Turbo filters the environment: a variable a task does not declare
      // never reaches it, even when the CI job sets it and the step logs
      // show it. Seven test files read DEV_DB_URL to assert against a real
      // Postgres, and without this line they see it unset and throw at
      // module load — which is exactly how the Test gate spent its life
      // verifying none of the schema it exists to protect.
      //
      // Seven, not five: the email-delivery phase added
      // `notification-delivery.repository.test.ts` and
      // `notification-delivery-constraints.test.ts` to the same pattern. The
      // count is not decoration — follow-up #53 is the argument for moving all
      // of them off a shared remote Neon, and it is only as convincing as the
      // number in front of it. `grep -rl DEV_DB_URL packages/backend/src`.
      //
      // The `e2e` task below needed the same treatment for E2E_DB_URL, and
      // ci.yml's comment on that job already spelled the trap out. It cost
      // a CI round to rediscover it here.
      "passThroughEnv": ["DEV_DB_URL"]
    },
    "e2e": {
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["E2E_DB_URL", "E2E_API_URL", "E2E_WEB_URL", "NTIZO_E2E_NODE_BIN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy:dev": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
