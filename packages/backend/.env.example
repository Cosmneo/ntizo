# packages/backend — used by drizzle-kit (generate/migrate/studio).
# Copy to .env and fill in values for whichever stage you're targeting.

# drizzle-kit picks one of these based on the STAGE script variant
# (db:auth:dev:* / db:auth:qa:* / db:auth:prod:*, same for db:ntizo:*).
DEV_DB_URL=postgresql://user:password@host/ntizo_dev?sslmode=require
QA_DB_URL=postgresql://user:password@host/ntizo_qa?sslmode=require
PROD_DB_URL=postgresql://user:password@host/ntizo_prod?sslmode=require
