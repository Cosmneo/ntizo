# Backend API (Hono) — copy to .env and fill in values.

STAGE=local
LOG_LEVEL=info

# Neon / Postgres connection string used at runtime by the API.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better-auth secret (generate with: openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Resend (https://resend.com) — API key + verified sender.
RESEND_API_KEY=
APP_URL="http://localhost:3000"
EMAIL_FROM="Ntizo <noreply@ntizo.com>"

# OAuth providers (optional — if empty, buttons stay hidden).
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8788/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://portal.azure.com → App registrations
# Redirect URI: http://localhost:8788/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: port override for local dev.
PORT=8788
