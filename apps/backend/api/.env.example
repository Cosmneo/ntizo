# Backend API (Hono) — copy to .env and fill in values.

STAGE=local
LOG_LEVEL=info

# Neon / Postgres connection string used at runtime by the API.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better-auth secret (generate with: openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Resend (https://resend.com) — API key + verified sender.
RESEND_API_KEY=
APP_URL="http://localhost:3000"
EMAIL_FROM="Ntizo <noreply@ntizo.co.mz>"

# Resend webhook signing secret for POST /api/webhooks/resend
# (Resend dashboard → Webhooks → the endpoint → Signing Secret; starts
# "whsec_"). Deployed stages set it with:
#   wrangler secret put RESEND_WEBHOOK_SECRET --env <stage>
# NOT a wrangler `var` — anyone holding it can forge a bounce for any address,
# and a permanent bounce suppresses that address with no un-suppression path.
# Leave it empty locally: the route then refuses every event with a 500 and
# says so in the log, rather than accepting unverified ones.
RESEND_WEBHOOK_SECRET=

# OAuth providers (optional — if empty, buttons stay hidden).
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8788/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://portal.azure.com → App registrations
# Redirect URI: http://localhost:8788/api/auth/callback/microsoft

# Optional: port override for local dev.
PORT=8788
