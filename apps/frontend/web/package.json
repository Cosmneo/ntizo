{
  "name": "@ntizo/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy:dev": "vite build && wrangler deploy --env dev",
    "deploy:qa": "vite build && wrangler deploy --env qa",
    "deploy:prod": "vite build && wrangler deploy --env prod"
  },
  "dependencies": {
    "@ntizo/frontend-ui": "workspace:*",
    "@ntizo/shared": "workspace:*",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^7.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@ntizo/eslint-config": "workspace:*",
    "@ntizo/typescript-config": "workspace:*",
    "@tanstack/router-plugin": "^1.159.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "5.9.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.0.0"
  }
}
