{
  "name": "ntizo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "deploy:dev": "turbo run deploy:dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "!(apps/frontend/**)/*.{ts,tsx,md,json,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.7.4",
    "turbo": "^2.8.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/frontend/*",
    "apps/backend/*",
    "apps/mobile/*",
    "apps/e2e",
    "packages/*",
    "packages/tooling/*"
  ],
  "overrides": {
    "@cosmneo/onion-lasagna": "1.0.0-beta.3",
    "@cosmneo/onion-lasagna-saga": "1.0.0-beta.3",
    "@cosmneo/onion-lasagna-zod": "1.0.0-beta.3",
    "@cosmneo/onion-lasagna-hono": "1.0.0-beta.3",
    "@cosmneo/onion-lasagna-yoga": "1.0.0-beta.3",
    "@cosmneo/onion-lasagna-graphql-client": "1.0.0-beta.3",
    "@cosmneo/onion-lasagna-graphql-react-query": "1.0.0-beta.3",
    "lightningcss": "1.30.1"
  }
}
